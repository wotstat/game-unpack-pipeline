{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wotstat.info/contracts/game-downloader/file-manifest-entry/v1.1.0.json",
  "title": "GameSnapshot v1 file manifest entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["path", "layer", "size", "sha256", "source", "representation"],
  "properties": {
    "path": { "$ref": "#/$defs/relativePath" },
    "layer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "base" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "language"],
          "properties": {
            "kind": { "const": "locale" },
            "language": { "$ref": "#/$defs/language" }
          }
        }
      ]
    },
    "size": { "type": "integer", "minimum": 0 },
    "sha256": { "$ref": "#/$defs/sha256" },
    "source": {
      "oneOf": [
        { "$ref": "#/$defs/gamePackageSource" },
        { "$ref": "#/$defs/looseFileSource" }
      ]
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_path", "source_sha256", "diagnostics"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "passthrough",
            "pyc-to-py",
            "packed-xml-to-xml",
            "mo-to-po",
            "web-format"
          ]
        },
        "source_path": { "$ref": "#/$defs/relativePath" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "tool": { "type": "string", "minLength": 1 },
        "tool_version": { "type": "string", "minLength": 1 },
        "diagnostics": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "passthrough" } } },
          "else": { "required": ["tool", "tool_version"] }
        }
      ]
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*\\\\)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^/\\u0000]+(?:/[^/\\u0000]+)*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "language": { "type": "string", "pattern": "^[A-Z]{2}(?:_[A-Z]{2})?$" },
    "sourceCommon": {
      "type": "object",
      "properties": {
        "part": {
          "type": "string",
          "enum": ["client", "sdcontent", "hdcontent", "locale"]
        },
        "part_version": { "type": "string", "minLength": 1 },
        "language": { "$ref": "#/$defs/language" },
        "entry_path": { "$ref": "#/$defs/relativePath" },
        "entry_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "gamePackageSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "part",
        "part_version",
        "game_package_path",
        "game_package_sha256",
        "entry_path",
        "entry_sha256"
      ],
      "properties": {
        "kind": { "const": "game-package" },
        "part": { "$ref": "#/$defs/sourceCommon/properties/part" },
        "part_version": { "$ref": "#/$defs/sourceCommon/properties/part_version" },
        "language": { "$ref": "#/$defs/language" },
        "game_package_path": { "$ref": "#/$defs/relativePath" },
        "game_package_sha256": { "$ref": "#/$defs/sha256" },
        "entry_path": { "$ref": "#/$defs/relativePath" },
        "entry_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "looseFileSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "part",
        "part_version",
        "client_tree_path",
        "client_tree_sha256",
        "entry_path",
        "entry_sha256"
      ],
      "properties": {
        "kind": { "const": "loose-file" },
        "part": { "$ref": "#/$defs/sourceCommon/properties/part" },
        "part_version": { "$ref": "#/$defs/sourceCommon/properties/part_version" },
        "language": { "$ref": "#/$defs/language" },
        "client_tree_path": { "$ref": "#/$defs/relativePath" },
        "client_tree_sha256": { "$ref": "#/$defs/sha256" },
        "entry_path": { "$ref": "#/$defs/relativePath" },
        "entry_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
